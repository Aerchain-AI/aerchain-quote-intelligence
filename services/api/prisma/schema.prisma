generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A procurement buyer. No production auth in this prototype (PRD 34), but every
/// RFx still records who raised it and when — that is audit trail, not login.
model Buyer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  team      String
  createdAt DateTime @default(now())

  rfxs Rfx[]
}

model Rfx {
  id                 String   @id @default(uuid())
  name               String
  category           String
  requiredByDate     DateTime
  currency           String
  description        String
  /// draft | active | awarded — lets past events be offered as precedent.
  status             String   @default("active")
  /// The buyer's original free-text ask, kept so similar future asks can match on it.
  sourceRequest      String?
  /// The clarifying questions and answers that shaped this RFx, as JSON.
  clarificationsJson String?
  buyerId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  /// When the RFx was issued to suppliers. Null while it is still a draft.
  issuedAt DateTime?

  buyer       Buyer?           @relation(fields: [buyerId], references: [id])
  lineItems   LineItem[]
  vendors     Vendor[]
  timeline    RfxEvent[]
  invitations RfxInvitation[]
  inbound     InboundMessage[]

  @@index([buyerId])
  @@index([category])
}

/// Milestones on a sourcing event. Stored rather than derived at render time so
/// the timeline is a record of what happened, not a story assembled on demand.
model RfxEvent {
  id         String   @id @default(uuid())
  rfxId      String
  /// created | issued | response_received | extraction_complete | shortlisted | awarded | note
  type       String
  title      String
  detail     String?
  actor      String?
  occurredAt DateTime

  rfx Rfx @relation(fields: [rfxId], references: [id], onDelete: Cascade)

  @@index([rfxId])
}

model LineItem {
  id            Int    @id // matches the fixed RFx item number, 1-30
  rfxId         String
  name          String
  specification String
  quantity      Int
  unit          String

  rfx    Rfx           @relation(fields: [rfxId], references: [id])
  quotes VendorQuote[]

  @@index([rfxId])
}

model Vendor {
  id                String    @id @default(uuid())
  rfxId             String
  name              String // "Vendor A".."Vendor E"
  responseFormat    String // xlsx | pdf | docx | jpg | txt
  filePath          String
  status            String    @default("pending") // pending|processing|processed|review_required|failed
  itemsFoundCount   Int?
  itemsMissingCount Int?
  overallConfidence Float?
  processingMs      Int?
  processedAt       DateTime?

  rfx           Rfx                     @relation(fields: [rfxId], references: [id])
  quotes        VendorQuote[]
  exceptions    QuoteException[]
  questionnaire QuestionnaireResponse[]

  @@index([rfxId])
}

model VendorQuote {
  id         String @id @default(uuid())
  vendorId   String
  lineItemId Int

  sourceValue    Float?
  sourceCurrency String?
  sourceUnit     String?

  normalizedValue    Float?
  normalizedCurrency String
  normalizedUnit     String

  aiInterpretedValue    Float?
  aiInterpretedCurrency String?
  aiInterpretedUnit     String?

  discountJson String? // JSON MoneyAdjustment | null
  freightJson  String? // JSON MoneyAdjustment | null
  taxJson      String? // JSON MoneyAdjustment | null

  evaluatedValue Float?

  confidence      Float?
  confidenceLevel String? // high|medium|low
  status          String // verified|flagged|not_quoted

  sourceDocument String?
  sourceLocation String?
  sourceExcerpt  String?
  fxRateJson     String? // JSON FxRateInfo | null
  notes          String?

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  lineItem LineItem @relation(fields: [lineItemId], references: [id])

  @@unique([vendorId, lineItemId])
  @@index([vendorId])
  @@index([lineItemId])
}

model QuoteException {
  id         String @id @default(uuid())
  vendorId   String
  lineItemId Int?
  type       String
  message    String
  severity   String // info|warning|critical

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model QuestionnaireResponse {
  id           String   @id @default(uuid())
  vendorId     String
  questionId   Int
  questionText String
  answerText   String
  passFail     Boolean?
  confidence   Float?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, questionId])
  @@index([vendorId])
}

/// Cached copilot answers. The deterministic calculation is cheap and always
/// re-run; only the LLM's intent-parse and prose explanation are cached, keyed to
/// a dataVersion derived from vendor processing timestamps so any re-extraction
/// invalidates it automatically.
model CopilotAnswerCache {
  id          String   @id @default(uuid())
  rfxId       String
  dataVersion String
  questionKey String
  question    String
  payloadJson String
  createdAt   DateTime @default(now())

  @@unique([rfxId, dataVersion, questionKey])
  @@index([rfxId])
}

/// A supplier the business can invite to quote — the master registry, distinct
/// from `Vendor`, which is one supplier's response to one event.
///
/// Performance figures are the buyer's reason to pick one supplier over another,
/// so they are stored per supplier and shown on the invite screen. A supplier
/// added ad-hoc by email has no history yet, and says so rather than showing
/// zeros that would read as bad performance.
model Supplier {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  category String
  /// Free-text note on what they have supplied before.
  pastWork String?

  /// Registration details from the supplier master. The verification status is
  /// shown wherever the supplier appears, because awarding to one whose
  /// registration is still pending is a decision, not a detail.
  city               String?
  gstin              String?
  /// verified | pending | unverified
  verificationStatus String  @default("unverified")
  verificationNote   String?
  paymentTerms       String?

  eventsInvited     Int       @default(0)
  eventsQuoted      Int       @default(0)
  eventsAwarded     Int       @default(0)
  avgResponseDays   Float?
  onTimeDeliveryPct Float?
  /// 0-1. Aggregated quality/compliance record.
  qualityScore      Float?
  lastEngagedAt     DateTime?
  /// True when added during an invite with no prior history.
  isNew             Boolean   @default(false)

  createdAt     DateTime            @default(now())
  invitations   RfxInvitation[]
  participation PastParticipation[]

  @@index([category])
}

/// A procurement that completed before this system existed.
///
/// Its award value and saving were supplied as a record, not computed here. They
/// live in their own table and are labelled at every point of display, because a
/// number this system can prove and a number it was told are not the same kind of
/// thing, and letting the two mix would quietly undo the reason the derivation
/// panel exists.
model PastProcurement {
  id          String   @id @default(uuid())
  /// The reference the record arrived with, e.g. PRC-2025-041.
  externalId  String   @unique
  title       String
  category    String
  completedAt DateTime

  awardedSupplierId String?
  awardedVendorName String
  awardValueInr     Float
  baselineInr       Float?
  savingsInr        Float?
  savingsPct        Float?

  /// Where these figures came from. Never "computed by this system".
  source String @default("Imported historical record")

  participation PastParticipation[]

  @@index([category])
}

/// One supplier's involvement in a past procurement, awarded or not.
model PastParticipation {
  id               String  @id @default(uuid())
  supplierId       String
  procurementId    String
  /// awarded | participated
  result           String
  performance      String?
  qualityIncidents Int     @default(0)

  supplier    Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  procurement PastProcurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)

  @@unique([supplierId, procurementId])
  @@index([supplierId])
}

/// One supplier invited to one RFx, with the exact email that was sent.
model RfxInvitation {
  id           String   @id @default(uuid())
  rfxId        String
  supplierId   String
  email        String
  emailSubject String
  emailBody    String
  status       String   @default("sent") // sent | responded | declined
  sentAt       DateTime @default(now())

  /// Filled in when a reply to this invitation is matched from the inbox.
  respondedAt       DateTime?
  responseSubject   String?
  /// RFC 5322 Message-ID of the reply, so a re-sync recognises it again.
  responseMessageId String?

  rfx      Rfx      @relation(fields: [rfxId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([rfxId, supplierId])
  @@index([rfxId])
}

/// A message pulled from the inbox.
///
/// Stored whether or not it could be matched to an event. An unmatched message
/// is a fact about the world — a supplier replied and we could not place them —
/// and dropping it, or filing it against a best-guess event, would be the same
/// mistake as valuing an unquoted line at zero. It waits in a tray for a buyer
/// to assign instead.
model InboundMessage {
  id         String @id @default(uuid())
  /// The mailbox's own identifier. Unique, so re-syncing never files a message
  /// twice however many times it is fetched.
  externalId String @unique

  /// RFC 5322 headers, kept because they are the only exact way to thread a
  /// reply back to the invitation that provoked it.
  messageId String?
  inReplyTo String?

  fromEmail  String
  fromName   String?
  /// JSON array of every To and Cc address, which is where a plus-addressed
  /// reply token arrives.
  toJson     String
  subject    String
  receivedAt DateTime
  /// First few lines of the body, for the responses list.
  snippet    String

  /// JSON array of { filename, contentType, size, storedPath }.
  attachmentsJson String @default("[]")
  /// imap | sample — which transport produced this.
  source          String

  rfxId           String?
  supplierId      String?
  /// reply_token | in_reply_to | sender | subject — how the match was made.
  matchedBy       String?
  /// exact | high | medium
  matchConfidence String?
  /// Set once a vendor row has been created from an attachment on this message.
  vendorId        String?
  /// unmatched | matched | ingested | ignored
  status          String  @default("unmatched")
  note            String?

  createdAt DateTime @default(now())

  rfx Rfx? @relation(fields: [rfxId], references: [id], onDelete: Cascade)

  @@index([rfxId])
  @@index([status])
  @@index([fromEmail])
}
