# Gemini API keys (Google AI Studio), comma-separated. The pool fails over to the
# next key when one hits its per-model daily quota, so adding keys is the simplest
# way to buy more headroom. Order is the failover order.
# Get free keys at aistudio.google.com -> Get API key.
GEMINI_API_KEYS=

# A single GEMINI_API_KEY is still honoured if you prefer one key.

# SQLite file location — Prisma resolves this relative to prisma/schema.prisma,
# so the actual file ends up at services/api/prisma/dev.db. This value is also
# duplicated in services/api/.env, which is what the Prisma CLI actually reads
# (it doesn't look at the repo-root .env).
DATABASE_URL="file:./dev.db"

# API server port
PORT=4000

# ---------------------------------------------------------------- inbox
# Reading supplier replies out of a mailbox.
#
# Leave all of this unset and the app reads the sample inbox instead — real
# .eml files in data/inbound-samples, parsed by the same code. The demo runs on
# those, so it needs no mailbox and cannot fail on a network call.
#
# Set these three and it connects to a real mailbox over IMAP, read-only. Use a
# throwaway account, not your own: a deployed instance will be reading whatever
# is in it. For Gmail, generate an app password rather than using your login.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Optional. Defaults: port 993, TLS on, INBOX.
IMAP_PORT=993
IMAP_SECURE=true
IMAP_MAILBOX=INBOX

# The address suppliers are asked to reply to. Each event gets its own
# plus-addressed variant (you+rfx-1a2b3c4d@example.com), which is the most
# reliable way to know which event a reply answers.
INBOX_ADDRESS=
